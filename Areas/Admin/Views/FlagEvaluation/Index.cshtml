@using LittleArkFoundation.Areas.Admin.Models.FlagEvaluation
@model FlagEvaluationViewModel
@{
	ViewData["Title"] = "DSS";
    Layout = "_AdminLayout";
}

<style>
    .menu-bar a {
        min-width: 100px;
        text-align: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

        .header-bar h2 {
            margin-bottom: 0;
        }

    .sticky-col {
        position: sticky;
        left: 0;
        background: white;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
    }

</style>

<div class="header-bar">
    <h2>Decision Support System</h2>

    <div class="menu-bar d-flex gap-2">
        <a class="btn btn-outline-dark @(
           ViewContext.RouteData.Values["controller"]?.ToString() == "Criteria" &&
           (
               ViewContext.RouteData.Values["action"]?.ToString() == "Index" ||
               ViewContext.RouteData.Values["action"]?.ToString() == "Edit"
           ) ? "active" : "")"
           asp-action="Index" asp-controller="Criteria">Diagnosis</a>

        <a class="btn btn-outline-dark @(
           ViewContext.RouteData.Values["controller"]?.ToString() == "AgeModifier" &&
           (
               ViewContext.RouteData.Values["action"]?.ToString() == "Index" ||
               ViewContext.RouteData.Values["action"]?.ToString() == "Edit"
           ) ? "active" : "")"
           asp-action="Index" asp-controller="AgeModifier">Age Modifier</a>

	   <a class="btn btn-outline-dark @(
           ViewContext.RouteData.Values["controller"]?.ToString() == "FlagEvaluation" &&
           (
               ViewContext.RouteData.Values["action"]?.ToString() == "Index" ||
               ViewContext.RouteData.Values["action"]?.ToString() == "Edit"
           ) ? "active" : "")"
           asp-action="Index" asp-controller="FlagEvaluation">Flag Evaluation</a>
    </div>
</div>
<hr />

<div class="d-flex justify-content-between align-items-center flex-wrap">
    @* Left toggles/buttons *@
    <div class="d-flex align-items-center gap-3">
		@if (User.HasClaim("Permission", "EditDSS"))
		{
		   <button type="button" class="btn btn-success hide-when-archived" data-bs-toggle="modal" data-bs-target="#editFlagEvaluationModal"
                    data-bs-toggle="tooltip"
                    title="Edit Flag Evaluation">
                 <i class="bx bx-edit"></i> Edit Flag Evaluation
            </button>
		}
		else
		{
			<a class="btn btn-success text-muted hide-when-archived"
			   style="cursor: not-allowed;"
			   aria-disabled="true"
			   tabindex="-1"
			   title="You do not have permission to edit flag evaluation">
               <i class="bx bx-edit"></i> Edit Flag Evaluation
           </a>
		}

    </div>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="width: 60%;">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="width: 60%;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid px-0 mx-0" style="max-width: 1600px;">
    <div class="table-responsive" style="overflow-x: auto;">
        <table class="table" style="min-width: 1200px;">
            <thead>
                @if (Model != null)
                {
                    <tr>
                        <th class="sticky-col" style="left: 0; z-index: 2;">Age</th>
                        <th>Modifier</th>
                    </tr>
                }
            </thead>
            <tbody>
                @if (Model != null)
                {
					<tr>
						<td>@Model.FlagEvaluationList[0].Flag</td>
						<td>&ge; @Model.FlagEvaluationList[0].Threshold</td>
					</tr>
					<tr>
						<td>@Model.FlagEvaluationList[1].Flag</td>
						<td>&gt; @Model.FlagEvaluationList[1].Threshold &lt; @Model.FlagEvaluationList[2].Threshold</td>
					</tr>
					<tr>
						<td>@Model.FlagEvaluationList[3].Flag</td>
						<td>&le; @Model.FlagEvaluationList[3].Threshold</td>
					</tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Edit Flag Evaluation -->
<div class="modal fade" id="editFlagEvaluationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                     Edit Flag Evaluation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="editFlagEvaluationForm" asp-action="Edit" asp-controller="FlagEvaluation" method="post">
                    @Html.AntiForgeryToken()

                    <div class="list-group-item d-flex justify-content-between align-items-center mt-3">
						 <h6 class="ms-2">Flag</h6>
						 <h6 class="ms-2">Threshold</h6>
					</div>

					<ul class="list-group">
						
                        <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-2">

							<!-- Hidden fields -->
							<input type="hidden" asp-for="FlagEvaluationList[0].Id" />
							<input type="hidden" asp-for="FlagEvaluationList[0].Condition" />
							<input type="hidden" asp-for="FlagEvaluationList[0].Flag" />

							<!-- Flag part -->
							<div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 220px;">
                                <div style="font-size: larger;">
									<span class="badge bg-success p-2">
										<i class="bi bi-flag-fill"></i> @Model.FlagEvaluationList[0].Flag Flag
									</span>
								</div>
							</div>

							<!-- Threshold part -->
							<div class="input-group" style="max-width: 100px;">
								<span class="input-group-text">&ge;</span>
								<input type="number" 
									   class="form-control text-center" 
									   min="1" step="1" 
									   asp-for="FlagEvaluationList[0].Threshold" 
									   required>
							</div>

						</li>

                        <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-2">

							<!-- Hidden fields -->
							<input type="hidden" asp-for="FlagEvaluationList[1].Id" />
							<input type="hidden" asp-for="FlagEvaluationList[1].Condition" />
							<input type="hidden" asp-for="FlagEvaluationList[1].Flag" />
                            <input type="hidden" asp-for="FlagEvaluationList[2].Id" />
							<input type="hidden" asp-for="FlagEvaluationList[2].Condition" />
							<input type="hidden" asp-for="FlagEvaluationList[2].Flag" />

							<!-- Flag part -->
							<div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 220px;">
								<div style="font-size: larger;">
									<span class="badge bg-warning p-2">
										<i class="bi bi-flag-fill"></i> @Model.FlagEvaluationList[1].Flag Flag
									</span>
								</div>
							</div>

							<!-- Threshold part -->
							<div class="input-group" style="max-width: 250px;">
								<span class="input-group-text">&gt;</span>
								<input id="leftNum" type="number" 
									   class="form-control text-center" 
									   min="1" step="1" 
									   asp-for="FlagEvaluationList[1].Threshold" 
									   required>
								<span class="input-group-text">&lt;</span>
								<input id="rightNum" type="number" 
									   class="form-control text-center" 
									   min="1" step="1" 
									   asp-for="FlagEvaluationList[2].Threshold" 
									   required>
							</div>

						</li>

                        <div class="invalid-feedback text-center">
							Right threshold must be greater than or equal to left threshold.
						</div>

						<li class="list-group-item d-flex justify-content-between align-items-center px-3 py-2">

							<!-- Hidden fields -->
							<input type="hidden" asp-for="FlagEvaluationList[3].Id" />
							<input type="hidden" asp-for="FlagEvaluationList[3].Condition" />
							<input type="hidden" asp-for="FlagEvaluationList[3].Flag" />

							<!-- Flag part -->
							<div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 220px;">
                                <div style="font-size: larger;">
									<span class="badge bg-danger p-2">
										<i class="bi bi-flag-fill"></i> @Model.FlagEvaluationList[3].Flag Flag
									</span>
								</div>
							</div>

							<!-- Threshold part -->
							<div class="input-group" style="max-width: 100px;">
								<span class="input-group-text">&le;</span>
								<input type="number" 
									   class="form-control text-center" 
									   min="1" step="1" 
									   asp-for="FlagEvaluationList[3].Threshold" 
									   required>
							</div>

						</li>
						
					</ul>

					<div class="modal-footer">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Close
                        </button>

                        <button type="submit"
                                class="btn btn-success"
                                onclick="return confirmFormSubmit('editFlagEvaluationForm', 'Confirm Edit Flag Evaluation', 'Are you sure you want to edit flag evaluation?')">
                            <i class="bi bi-floppy"></i> Save Changes
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
		const leftThreshold = document.getElementById("leftNum");
		const rightThreshold = document.getElementById("rightNum");

		function validateThresholdRange() {

			const left = parseInt(leftThreshold.value);
			const right = parseInt(rightThreshold.value);

			if (!isNaN(left) && !isNaN(right) && left > right) {

				rightThreshold.setCustomValidity("Right threshold must be greater than or equal to left threshold.");
				rightThreshold.classList.add("is-invalid");

			} else {

				rightThreshold.setCustomValidity("");
				rightThreshold.classList.remove("is-invalid");

			}
		}

		leftThreshold.addEventListener("input", validateThresholdRange);
		rightThreshold.addEventListener("input", validateThresholdRange);
	</script>    
}
