@using System.Text.Json
@model LittleArkFoundation.Areas.Admin.Models.OPD.OPDViewModel
@{
    ViewData["Title"] = "Statistics";
    Layout = "_AdminLayout";
    string? sortBy = ViewBag.sortBy ?? "";
    string? sortByUserID = ViewBag.sortByUserID ?? "";
    string? sortByMonth = ViewBag.sortByMonth ?? "";
    bool matchedUser = Model.Users.Any(u => u.Username == sortBy);

}

<style>
    .menu-bar a {
        min-width: 100px;
        text-align: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

        .header-bar h2 {
            margin-bottom: 0;
        }

    .sticky-col {
        position: sticky;
        left: 0;
        background: white;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
    }

    .container-general {
		margin: 10px;
        padding: 25px;
        width: 100%;
        max-width: 1260px;
        /* height: 500px; */
        /* border: 1px solid #5a5a5a; */
        border-radius: 15px;
        align-items: center;
        text-align: center;
        color: white;
        background-color: rgb(125 125 125);
        box-shadow: 0px 0px 15px rgb(217, 217, 217);
    }

    .container-general canvas {
        width: 100% !important;
        height: auto !important;
    }

</style>

<div class="header-bar">
    <h2>OPD Statistics</h2>

    <div class="menu-bar d-flex gap-2">
        <a class="btn btn-outline-dark @(
           ViewContext.RouteData.Values["action"]?.ToString() == "Index" ||
           ViewContext.RouteData.Values["action"]?.ToString() == "SortBy" ||
           ViewContext.RouteData.Values["action"]?.ToString() == "Search"
           ? "active" : "")"
           asp-action="Index" asp-controller="OPD">Main</a>

        <a class="btn btn-outline-dark @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")"
           asp-action="Reports" asp-controller="OPD">Reports</a>

        <a class="btn btn-outline-dark @(
                ViewContext.RouteData.Values["action"]?.ToString() == "Statistics" ||
                ViewContext.RouteData.Values["action"]?.ToString() == "SortByStatistics" ||
                ViewContext.RouteData.Values["action"]?.ToString() == "EditStatistics" ||
					 ViewContext.RouteData.Values["action"]?.ToString() == "StatisticsChart"
                ? "active" : "")"
           asp-action="Statistics" asp-controller="OPD">Statistics</a>
    </div>
</div>
<hr />

<!-- Back to List -->
<div class="mt-2">
    <a class="btn btn-outline-secondary mb-3" asp-controller="OPD" asp-action="Statistics">
        <i class="bi bi-arrow-left-square"></i> Back to List
    </a>
</div>

<div class="text-center mb-2">
    <h5 style="font-weight: bold;">Filter by Month</h5>
    @for (int i = 1; i <= 12; i++)
    {
        var monthName = new DateTime(2025, i, 1).ToString("MMM");
        <a asp-action="StatisticsChart"
        asp-route-userID="@(ViewBag.SelectedUserID ?? 0)"
           asp-route-month="@i"
           class="btn btn-sm @(i == (ViewBag.SelectedMonth ?? DateTime.Now.Month) ? "btn-secondary" : "btn-outline-secondary") m-1">
            @monthName
        </a>
    }
</div>

<div class="d-flex justify-content-center mb-3">
    @* MSW filter *@
	<button type="button" class="btn @(ViewBag.SelectedUserID > 0 ? "btn-secondary" : "btn-outline-secondary") btn-sm dropdown-toggle d-flex align-items-center gap-1 me-2" data-bs-toggle="dropdown" aria-expanded="false">
		@if (ViewBag.SelectedUserID == 0)
		{
			<span class="mb-0">Filter by MSW</span>
		}
		else
		{
			<span class="mb-0">@ViewBag.SelectedUserName</span>
		}
	</button>
	<ul class="dropdown-menu dropdown-menu-end">
		<li>
			<a class="dropdown-item"
            asp-action="StatisticsChart"
            asp-route-userID="0"
           asp-route-month="@(ViewBag.SelectedMonth ?? DateTime.Now.Month)">All</a>
		</li>
		@foreach (var user in Model.Users)
		{
			<li>
				<a class="dropdown-item" 
                asp-action="StatisticsChart"
            asp-route-userID="@user.UserID"
           asp-route-month="@(ViewBag.SelectedMonth ?? DateTime.Now.Month)">@user.Username</a>
			</li>
		}
	</ul>
</div>

<div class="d-flex justify-content-center align-items-center">
   
    <div class="container-general">
	   <div>
            <canvas id="sourcesBreakdown"></canvas>
        </div>
    </div>

    <div class="container-general">
	   <div>
            <canvas id="caseLoadBreakdown"></canvas>
        </div>
    </div>

    <div class="container-general">
	   <div>
            <canvas id="caseManagementBreakdown"></canvas>
        </div>
    </div>
    
</div>

<div class="d-flex justify-content-center align-items-center">
   
    <div class="container-general">
        <div>
            <canvas id="generalSourceOfReferral"></canvas>
        </div>
    </div>

    <div class="container-general">
